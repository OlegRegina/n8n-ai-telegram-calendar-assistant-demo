    {
      "parameters": {
        "jsCode": "// Sucht den Termin, der geändert werden soll, und berechnet die neue Zeit aus dem gefundenen Termin.\n// Genau ein Treffer und eine erkannte neue Zeit → ändern. Sonst: dem Nutzer antworten, nichts ändern.\n// Die KI liefert nur, was der Nutzer wirklich gesagt hat (new_date, new_time, new_duration_minutes); alles andere kommt aus dem Termin.\nconst TZ = 'Europe/Zurich';\nconst out = $('AI — Detect Intent').first().json.output;\nconst title = String(out.title ?? '').toLowerCase().trim();\nconst lang = String(out.language || 'de').toLowerCase().slice(0, 2);\nconst events = $input.all().map(i => i.json).filter(e => e && e.id);\nlet matches = title ? events.filter(e => String(e.summary ?? '').toLowerCase().includes(title)) : [];\n// Mehrere Treffer und die bisherige Startzeit ist bekannt: auf genau diesen Termin eingrenzen\nif (matches.length > 1 && out.start) {\n  const want = DateTime.fromISO(out.start).toMillis();\n  const exact = matches.filter(e => e.start && e.start.dateTime && DateTime.fromISO(e.start.dateTime).toMillis() === want);\n  if (exact.length) matches = exact;\n}\nconst when = e => DateTime.fromISO(e.start?.dateTime || e.start?.date).setZone(TZ).toFormat('dd.MM. HH:mm');\nconst T = {\n  none: {\n    de: `Termin «${out.title}» nicht gefunden. Es wurde nichts geändert.`,\n    ru: `Событие «${out.title}» не найдено. Ничего не изменено.`,\n    en: `Event \"${out.title}\" not found. Nothing was changed.`,\n  },\n  multiple: {\n    de: 'Mehrere Termine passen. Welchen meinen Sie? Es wurde nichts geändert.',\n    ru: 'Подходит несколько событий. Какое из них? Ничего не изменено.',\n    en: 'Several events match. Which one do you mean? Nothing was changed.',\n  },\n  unclear: {\n    de: 'Neue Zeit nicht erkannt. Es wurde nichts geändert.',\n    ru: 'Новое время не распознано. Ничего не изменено.',\n    en: 'New time not recognised. Nothing was changed.',\n  },\n  allday: {\n    de: 'Ganztägige Termine verschiebe ich nicht. Es wurde nichts geändert.',\n    ru: 'События на весь день я не переношу. Ничего не изменено.',\n    en: 'All-day events are not moved. Nothing was changed.',\n  },\n};\nconst reply = (kind, extra = '') => [{ json: { _match: kind, matches: matches.length, text: (T[kind][lang] || T[kind].en) + extra } }];\nif (matches.length === 0) return reply('none');\nif (matches.length > 1) return reply('multiple', '\\n' + matches.slice(0, 5).map(e => `• ${when(e)} ${e.summary}`).join('\\n'));\nconst ev = matches[0];\nif (!ev.start?.dateTime || !ev.end?.dateTime) return reply('allday');\nconst s0 = DateTime.fromISO(ev.start.dateTime, { zone: TZ });\nconst e0 = DateTime.fromISO(ev.end.dateTime, { zone: TZ });\nconst okDate = /^\\d{4}-\\d{2}-\\d{2}$/.test(String(out.new_date ?? '')) && DateTime.fromISO(out.new_date).isValid;\nconst tm = String(out.new_time ?? '').match(/^([01]?\\d|2[0-3]):([0-5]\\d)$/);\nconst dur = Number(out.new_duration_minutes);\nconst okDur = Number.isFinite(dur) && dur > 0;\nif (!okDate && !tm && !okDur) return reply('unclear');\nconst day = okDate ? DateTime.fromISO(out.new_date, { zone: TZ }) : s0;\nconst s1 = day.set({ hour: tm ? Number(tm[1]) : s0.hour, minute: tm ? Number(tm[2]) : s0.minute, second: 0, millisecond: 0 });\nconst e1 = s1.plus({ minutes: okDur ? dur : Math.round(e0.diff(s0, 'minutes').minutes) });\nif (!s1.isValid || !e1.isValid) return reply('unclear');\nconst iso = x => x.toISO({ suppressMilliseconds: true });\nreturn [{ json: { ...ev, _match: 'found', _new_start: iso(s1), _new_end: iso(e1) } }];\n"
      },
